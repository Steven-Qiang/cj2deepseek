{
  "functions": {
    "node": {
      "runtime": "nodejs18",
      "entry": "./functions"
    }
  },
  "routes": [
    {
      "source": "/v1/chat/completions",
      "destination": "/functions/v1/chat/completions"
    },
    {
      "source": "/chat/completions",
      "destination": "/functions/v1/chat/completions"
    },
    {
      "source": "/v1/responses",
      "destination": "/functions/v1/responses"
    },
    {
      "source": "/responses",
      "destination": "/functions/v1/responses"
    },
    {
      "source": "/v1/models",
      "destination": "/functions/v1/models"
    },
    {
      "source": "/models",
      "destination": "/functions/v1/models"
    },
    {
      "source": "/",
      "destination": "/functions/index"
    },
    {
      "source": "/skin",
      "destination": "/functions/index"
    },
    {
      "source": "/skin/:id",
      "destination": "/functions/index"
    },
    {
      "source": "/robots.txt",
      "destination": "/functions/index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/functions/index"
    },
    {
      "source": "/og/:id.png",
      "destination": "/functions/index"
    }
  ]
}
